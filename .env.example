# ==============================================================================
# Cloud SOC & SOAR Lab — Environment Configuration Template
# 
# How to use:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Fill in your own API keys below.
# 3. Run any Python script (e.g. python3 soar-playbooks/soar_pipeline.py).
#    The script will automatically detect and load your .env file!
#
# NOTE: '.env' is included in .gitignore and will NEVER be committed to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VirusTotal API Key (Free Community Tier)
# ------------------------------------------------------------------------------
# Where to get it:
#   1. Sign up for a free account at https://www.virustotal.com
#   2. Click your profile avatar (top right) -> 'API Key'
#   3. Copy your 64-character personal API key here
# Used by:
#   - soar-playbooks/soar_pipeline.py (Automated hash threat reputation)
#   - soar-playbooks/tines_soar_story.json (Tines cloud HTTP Request node)
VT_API_KEY="your_virustotal_api_key_here"

# ------------------------------------------------------------------------------
# 2. Slack Incoming Webhook URL
# ------------------------------------------------------------------------------
# Where to get it:
#   1. Go to https://api.slack.com/apps -> Create New App -> From Scratch
#   2. Choose your private SOC workspace (e.g. 'dil-soc-workspace')
#   3. Under 'Features', click 'Incoming Webhooks' -> Turn it ON
#   4. Click 'Add New Webhook to Workspace' -> Select channel (e.g. #soc-alerts)
#   5. Copy the generated Webhook URL here
# Used by:
#   - soar-playbooks/soar_pipeline.py (Posts interactive Slack triage cards)
#   - soar-playbooks/tines_soar_story.json (Dispatches Slack message blocks)
SLACK_WEBHOOK_URL="your_slack_incoming_webhook_url_here"

# ------------------------------------------------------------------------------
# 3. LimaCharlie Cloud EDR API Key & Organization ID
# ------------------------------------------------------------------------------
# Where to get it:
#   1. Sign in to https://app.limacharlie.io
#   2. Go to 'Organization Settings' -> 'General' -> Copy 'Organization ID' (LC_OID)
#   3. Go to 'Organization Settings' -> 'API Keys' -> 'Create API Key'
#      Add permissions: 'sensor.isolate', 'sensor.task', 'detection.list'
#   4. Copy the generated REST API key here (LC_API_KEY)
# Used by:
#   - soar-playbooks/soar_pipeline.py (Automated/one-click host network isolation)
#   - dashboard/index.html (Simulated or live EDR REST API actions)
LC_API_KEY="your_limacharlie_api_key_here"
LC_OID="your_limacharlie_org_id_here"
